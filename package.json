{
  "name": "wealthgap-studio",
  "version": "2.0.0",
  "description": "YouTube video production pipeline & automation harness for The Wealth Gap",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "workflow/05-video",
    "workspace/*/05-video"
  ],
  "scripts": {
    "new-video": "bun run scripts/new_video.ts",
    "script:transcribe": "bun run workflow/02-scripting/transcribe_ref.ts",
    "script:remake": "bun run workflow/02-scripting/remake_script.ts",
    "tts:format": "bun run workflow/03-voiceover/src/format_sections.ts",
    "voice:setup": "bun run workflow/03-voiceover/src/voice_profile.ts",
    "voice:remake": "bun run workflow/03-voiceover/src/voice_profile.ts --remake",
    "tts": "bun run workflow/03-voiceover/run.ts",
    "tts:cloud": "bun run workflow/03-voiceover/run.ts --cloud",
    "tts:cost": "bun run workflow/03-voiceover/run.ts --cost",
    "tts:dry-run": "bun run workflow/03-voiceover/run.ts --dry-run",
    "tts:list": "bun run workflow/03-voiceover/run.ts --list",
    "transcribe": "bun run workflow/04-transcription/transcribe.ts",
    "video:ingest": "bun --cwd workflow/05-video scripts/ingest.ts",
    "video:analyze": "bun --cwd workflow/05-video scripts/analyze.ts",
    "video:plan": "bun --cwd workflow/05-video scripts/plan.ts",
    "video:check": "bun --cwd workflow/05-video scripts/validate-plan.ts",
    "video:studio": "bun --cwd workflow/05-video run studio",
    "video:draft": "bun --cwd workflow/05-video scripts/render.ts --draft",
    "video:render": "bun --cwd workflow/05-video scripts/render.ts --final",
    "video:chunk": "bun --cwd workflow/05-video scripts/chunk.ts",
    "video:qc": "bun --cwd workflow/05-video scripts/qc.ts",
    "video:package": "bun --cwd workflow/05-video scripts/package.ts",
    "video:build": "bun --cwd workflow/05-video scripts/build.ts",
    "video:test": "bun --cwd workflow/05-video scripts/test-fixture.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/captions": "4.0.536",
    "@remotion/cli": "4.0.536",
    "@remotion/google-fonts": "4.0.536",
    "@remotion/layout-utils": "4.0.536",
    "@remotion/media": "4.0.536",
    "@remotion/rough-notation": "4.0.536",
    "@remotion/sfx": "4.0.536",
    "@remotion/three": "^4.0.536",
    "@remotion/transitions": "4.0.536",
    "@remotion/zod-types": "4.0.536",
    "@types/three": "^0.186.0",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.536",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@gradio/client": "^2.7.1",
    "@remotion/eslint-config-flat": "4.0.536",
    "@types/bun": "latest",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "@types/topojson-client": "^3.1.5",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
