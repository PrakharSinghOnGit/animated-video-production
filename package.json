{
  "name": "wealthgap-studio",
  "version": "2.0.0",
  "description": "YouTube video production pipeline & automation harness for The Wealth Gap",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "workflow/05-video",
    "workflow/dashboard/web",
    "workspace/*/05-video",
    "workspace/*/shorts/*/05-video"
  ],
  "scripts": {
    "new-video": "bun run scripts/new_video.ts",
    "tts:format": "bun run workflow/03-voiceover/src/format_sections.ts",
    "models": "bun run workflow/lib/models.ts",
    "voice:design": ".venv/bin/python workflow/03-voiceover/src/design_voice.py",
    "voice:emotions": ".venv/bin/python workflow/03-voiceover/src/design_voice.py --emotions",
    "voice:use": "bun run workflow/03-voiceover/src/voice_profile.ts use",
    "voice:list": "bun run workflow/03-voiceover/src/voice_profile.ts list",
    "voice:design:gemini": ".venv/bin/python workflow/03-voiceover/src/design_voice_gemini.py",
    "tts": "bun run workflow/03-voiceover/run.ts",
    "tts:post": "bun run workflow/03-voiceover/src/post.ts",
    "voice:scan": "bun run workflow/03-voiceover/scan.ts",
    "voice:holds": "bun run workflow/03-voiceover/holds.ts",
    "tts:cost": "bun run workflow/03-voiceover/run.ts --cost",
    "tts:dry-run": "bun run workflow/03-voiceover/run.ts --dry-run",
    "tts:list": "bun run workflow/03-voiceover/run.ts --list",
    "audio:master": "bun run workflow/06-audio/master.ts",
    "audio:mix": "bun run workflow/06-audio/mix.ts",
    "daw": "bun run workflow/06-audio/opendaw/build.ts",
    "daw:setup": "bun run workflow/06-audio/opendaw/setup.ts",
    "audio:music": "bun run workflow/06-audio/music.ts",
    "music:beat": "bun run workflow/06-audio/rhythm.ts",
    "music:search": "bun run workflow/06-audio/music_search.ts",
    "music:lib": "bun run workflow/06-audio/music_lib.ts",
    "sfx:fetch": "bun run workflow/06-audio/sfx_fetch.ts",
    "sfx:check": "bun run workflow/06-audio/sfx_fetch.ts --check",
    "sfx:clips": "bun run workflow/06-audio/sfx_clips.ts",
    "deliver": "bun run workflow/deliver/deliver.ts",
    "fcp": "bun run workflow/deliver/deliver.ts --only fcp",
    "transcribe": "bun run workflow/04-transcription/transcribe.ts",
    "timeline": "bun run workflow/05-video/scripts/timeline.ts",
    "assemble": "bun run workflow/05-video/scripts/assemble.ts",
    "draft": "bun --cwd workflow/05-video scripts/render.ts --draft",
    "render": "bun --cwd workflow/05-video scripts/render.ts --final",
    "qc": "bun --cwd workflow/05-video scripts/qc.ts",
    "studio": "bun run workflow/05-video/scripts/studio.ts",
    "build": "bun run workflow/05-video/scripts/build_flow.ts",
    "captions": "bun run workflow/05-video/scripts/captions.ts",
    "direct": "bun run workflow/05-video/scripts/direct.ts",
    "act": "bun run workflow/05-video/scripts/author_act.ts",
    "frames": "bun run workflow/05-video/scripts/frames.ts",
    "seams": "bun run workflow/05-video/scripts/seams.ts",
    "cues": "bun run workflow/05-video/scripts/cues.ts",
    "timings": "bun run workflow/05-video/scripts/timings.ts",
    "tts:gaps": "bun run workflow/03-voiceover/gaps.ts",
    "dashboard": "bun run workflow/dashboard/ensure-build.ts && bun run workflow/dashboard/server.ts",
    "dashboard:public": "bun run workflow/dashboard/ensure-build.ts && bun run workflow/dashboard/server.ts --public",
    "dashboard:dev": "bun --cwd workflow/dashboard/web run dev",
    "srt": "bun run workflow/05-video/scripts/srt.ts",
    "write": "bun run workflow/02-scripting/write_script.ts",
    "review": "bun run workflow/05-video/scripts/review.ts",
    "preview": "bun run workflow/05-video/scripts/preview.ts",
    "meta": "bun run workflow/07-publish/meta.ts",
    "thumbs": "bun run workflow/07-publish/thumbs.ts",
    "thumbs:render": "bun run workflow/07-publish/thumbs.ts --render-only",
    "thumbs:review": "bun run workflow/07-publish/review.ts",
    "publish:export": "bun run workflow/07-publish/export.ts",
    "shorts:write": "bun run workflow/08-shorts/write.ts",
    "shorts": "bun run workflow/08-shorts/run.ts",
    "shorts:export": "bun run workflow/08-shorts/export.ts",
    "compact": "bun run scripts/compact.ts",
    "yt:auth": "bun run workflow/09-analytics/auth.ts",
    "yt:fetch": "bun run workflow/09-analytics/fetch.ts",
    "yt:mock": "bun run workflow/09-analytics/mock.ts",
    "yt:review": "bun run workflow/09-analytics/review.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.539",
    "@remotion/cli": "4.0.539",
    "@remotion/google-fonts": "4.0.539",
    "@remotion/layout-utils": "4.0.539",
    "@remotion/media": "4.0.539",
    "@remotion/renderer": "4.0.539",
    "@remotion/sfx": "4.0.539",
    "@remotion/zod-types": "4.0.539",
    "@wealthgap/kit": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.539",
    "uqr": "0.1.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.539",
    "@types/bun": "latest",
    "@types/node": "^22.20.5",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3"
  }
}
