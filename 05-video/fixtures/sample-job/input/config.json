{
  "fps": 30,
  "width": 1920,
  "height": 1080,
  "aspects": ["16:9"],
  "audioOffsetMs": 0,
  "tailPaddingMs": 1200,
  "captions": {
    "mode": "sidecar",
    "style": "clean-bottom",
    "wordsPerPage": 5
  },
  "music": {
    "file": null,
    "volume": 0.08,
    "duckTo": 0.03
  },
  "sfx": {
    "enabled": true,
    "volume": 0.25,
    "set": ["whoosh", "whip", "switch", "ding", "mouse-click", "page-turn"]
  },
  "render": {
    "draft": { "scale": 0.5, "crf": 28 },
    "final": { "codec": "h264", "crf": 16 }
  },
  "qc": {
    "failOnWarnings": false
  }
}
