# ========================================================
# WEALTHGAP STUDIO CONFIGURATION
# ========================================================

# Default active video project under workspace/
ACTIVE_VIDEO=VID02_Map_Of_Stock_Market

# --------------------------------------------------------
# Step 4: Transcription (Faster-Whisper)
# --------------------------------------------------------
# Optional: specify custom Python binary with faster-whisper installed
# PYTHON_PATH=/path/to/venv/bin/python

EPIDEMIC_API=xxx

NTFY_TOPIC=TheWealthGap
# Gemini TTS (bun run tts --gemini): an API key with the Gemini API (generativelanguage.googleapis.com) enabled.
# Without it (or if that API is off), the engine uses Vertex AI via `gcloud auth application-default login`;
# GOOGLE_CLOUD_PROJECT overrides the ADC quota project.
GEMINI_TTS=
# Voice engine when a run doesn't pick one: gemini (default) or qwen (local).
TTS_ENGINE=
# Dashboard over the internet (bun run dashboard:public): the sign-in password. Changing it signs every device out.
PWA_PASS=
