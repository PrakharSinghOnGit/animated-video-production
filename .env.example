# ========================================================
# WEALTHGAP STUDIO CONFIGURATION
# ========================================================

# Default active video project under workspace/
ACTIVE_VIDEO=VID02_Map_Of_Stock_Market

# --------------------------------------------------------
# Step 3: Voiceover (Sarvam AI Bulbul v4 Flash)
# --------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# Default persona for English:
#   varun_en_suspense     - Cinematic, intense, trailer/documentary tone
#   sunny_en_social       - Upbeat, engaging, creator style
#   dev_en_conversational - Natural, calm conversational narration
#   rohan_en_recovery     - Sharp, confident, business tone
SARVAM_DEFAULT_SPEAKER=varun_en_suspense

# Audio format
SARVAM_SAMPLE_RATE=48000
SARVAM_CODEC=wav

# Expression Intensity Scaling:
#   0.0 = completely neutral (pace: 1.0, pitch: 0.0, loudness: 1.0)
#   1.0 = full set intensity
#   0.3 = 30% subtle modulation (recommended)
SARVAM_EXPRESSION_SCALE=0.3

# Set pitch scale to 0.0 to completely disable pitch shifts while keeping pacing & loudness
SARVAM_PITCH_SCALE=0.0

# --------------------------------------------------------
# Step 4: Transcription (Faster-Whisper)
# --------------------------------------------------------
# Optional: specify custom Python binary with faster-whisper installed
# PYTHON_PATH=/path/to/venv/bin/python

EPIDEMIC_API=xxx
