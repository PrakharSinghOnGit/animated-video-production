{
  "compilerOptions": {
    "target": "ES2018",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["es2015", "dom"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "baseUrl": ".",
    "paths": {
      "@wealthgap/kit": ["../../packages/kit/src"],
      "@wealthgap/kit/*": ["../../packages/kit/src/*"]
    }
  },
  "exclude": ["remotion.config.ts"]
}
