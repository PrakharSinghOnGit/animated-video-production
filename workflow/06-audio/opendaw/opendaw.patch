diff --git a/packages/app/studio/src/service/WealthGap.ts b/packages/app/studio/src/service/WealthGap.ts
new file mode 100644
index 000000000..b6419891a
--- /dev/null
+++ b/packages/app/studio/src/service/WealthGap.ts
@@ -0,0 +1,83 @@
+// WealthGap video pipeline: ?bundle=<url> opens a project, ?export=<url> adds Export > "To video pipeline"
+import {DefaultObservableValue, Errors, isDefined, Nullable, Option, RuntimeNotifier, tryCatch} from "@opendaw/lib-std"
+import {WavFile} from "@opendaw/lib-dsp"
+import {Promises} from "@opendaw/lib-runtime"
+import {AudioContexts, MixdownSection, ProjectBundle} from "@opendaw/studio-core"
+import {StudioService} from "@/service/StudioService"
+import {Mixdowns} from "@/service/Mixdowns"
+
+// read once at load: the router rewrites the address bar afterwards
+const query = new URLSearchParams(location.search)
+const param = (name: string): Nullable<string> => query.get(name)
+
+export namespace WealthGap {
+    export const exportUrl = (): Nullable<string> => param("export")
+
+    // A build (?v=) already opened in this browser is not loaded again, so a second click on the dashboard
+    // button does not replace the edits made since.
+    export const openBundleFromQuery = async (service: StudioService): Promise<void> => {
+        const url = param("bundle")
+        if (!isDefined(url)) {return}
+        const key = `wg-bundle:${url.split("?")[0]}`
+        const build = new URL(url, location.href).searchParams.get("v") ?? ""
+        const stored = tryCatch(() => localStorage.getItem(key))
+        if (build !== "" && stored.status === "success" && stored.value === build) {
+            RuntimeNotifier.notify({message: "This build is already open here: use File > Open... for your saved project.", icon: "Info"})
+            return
+        }
+        const dialog = RuntimeNotifier.progress({headline: "Loading video project..."})
+        const {status, value: arrayBuffer, error} = await Promises.tryCatch(fetch(url).then(response => {
+            if (!response.ok) {throw new Error(`${response.status} ${response.statusText}`)}
+            return response.arrayBuffer()
+        }))
+        if (status === "rejected") {
+            dialog.terminate()
+            return RuntimeNotifier.info({headline: "Could not load the video project", message: String(error)})
+        }
+        const decoded = await Promises.tryCatch(ProjectBundle.decode(service, arrayBuffer))
+        dialog.terminate()
+        if (decoded.status === "rejected") {
+            return RuntimeNotifier.info({headline: "Could not decode the video project", message: String(decoded.error)})
+        }
+        service.projectProfileService.setValue(Option.wrap(decoded.value))
+        if (build !== "") {tryCatch(() => localStorage.setItem(key, build))}
+    }
+
+    const renderAndSend = async (service: StudioService, url: string): Promise<void> => {
+        const profile = service.projectProfileService.getValue().unwrapOrUndefined()
+        if (!isDefined(profile)) {return}
+        const project = profile.project.copy()
+        const section = MixdownSection.find(MixdownSection.collect(project), "song")
+        const abortController = new AbortController()
+        const progress = new DefaultObservableValue(0.0)
+        const dialog = RuntimeNotifier.progress({headline: "Rendering the mix for the video...", progress, cancel: () => abortController.abort()})
+        const rendered = await Promises.tryCatch(Mixdowns.render(project, Option.None, section, progress, abortController.signal, 48_000))
+        dialog.terminate()
+        if (rendered.status === "rejected") {
+            if (Errors.isAbort(rendered.error)) {return}
+            throw rendered.error
+        }
+        const wav = WavFile.encodeInts24(rendered.value)
+        const upload = RuntimeNotifier.progress({headline: "Sending the mix to the video pipeline..."})
+        const response = await Promises.tryCatch(fetch(url, {method: "POST", headers: {"x-wg": "1", "content-type": "audio/wav"}, body: wav}))
+        upload.terminate()
+        if (response.status === "rejected" || !response.value.ok) {
+            const why = response.status === "rejected" ? String(response.error) : `${response.value.status} ${await response.value.text()}`
+            RuntimeNotifier.info({headline: "Could not send the mix", message: `${why} (is the dashboard still running?)`})
+            return
+        }
+        RuntimeNotifier.notify({message: `Mix sent to the video (${(wav.byteLength / 1e6).toFixed(0)} MB). The next render uses it.`, icon: "Checkbox"})
+    }
+
+    export const exportToVideo = async (service: StudioService): Promise<void> => {
+        const url = exportUrl()
+        if (!isDefined(url)) {return}
+        await service.audioContext.suspend()
+        const {status, error} = await Promises.tryCatch(renderAndSend(service, url))
+        if (status === "rejected") {
+            console.warn(error)
+            RuntimeNotifier.notify({message: "Export to video failed.", icon: "Warning"})
+        }
+        AudioContexts.resume(service.audioContext).then()
+    }
+}
