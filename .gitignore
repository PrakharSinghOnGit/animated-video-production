# third-party reference material for the Drafting style (local only)
workflow/styles/drafting/reference/
# local runtime state in workspace/ (dashboard session key, model catalogue cache, OpenCode/Ollama config)
workspace/.*
# one-step undo copies written by the dashboard's Settings file editor
*.prev
